{
  "title": "ai-grid-provider-console values",
  "description": "values.yaml documents each key. Unknown keys are errors, so a misspelled --set or values file fails the install instead of being dropped.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "description": "Helm passes a parent chart's globals here; the chart reads none.",
      "type": "object"
    },
    "fullnameOverride": { "type": "string", "minLength": 1 },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authProxy": { "$ref": "#/definitions/image" },
        "console": { "$ref": "#/definitions/image" },
        "backend": { "$ref": "#/definitions/image" }
      }
    },
    "imagePullPolicy": {
      "description": "Empty: the cluster default.",
      "type": "string",
      "enum": ["", "Always", "IfNotPresent", "Never"]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "oauth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secretName": { "type": "string" },
        "cookieName": { "type": "string", "minLength": 1 }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceCA": { "type": "boolean" },
        "secretName": { "type": "string" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "destinationCACertificate": { "type": "string" },
        "timeout": {
          "description": "The router's timeout (haproxy.router.openshift.io/timeout), such as 70s: longer than authProxy.upstreamTimeout.",
          "type": "string",
          "pattern": "^[1-9][0-9]*(s|m|h)$"
        }
      }
    },
    "providerAdmins": {
      "description": "OpenShift groups and users of the hub bound to ClusterRole ai-grid-provider-admin; empty binds nobody.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "users": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gridConsumerUrl": { "type": "string" },
        "mapTileUrl": { "type": "string" },
        "mapTileAttribution": { "type": "string" },
        "billingUrl": { "type": "string" },
        "logLevel": {
          "description": "The BFF's LOG_LEVEL, which it reads in either case.",
          "type": "string",
          "enum": ["debug", "info", "warn", "error", "DEBUG", "INFO", "WARN", "ERROR"]
        },
        "perses": {
          "description": "The Monitoring page's Perses server.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string" },
            "project": { "type": "string" },
            "caFile": { "type": "string" }
          }
        },
        "models": {
          "description": "The Deploy model wizard's settings.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hardware": {
              "description": "The wizard's Hardware choices, rendered as the BFF's MODEL_HARDWARE; empty for its built-in list. The BFF checks the same rules at start. A schema can't refuse a duplicate id: the template and the BFF do.",
              "type": "array",
              "items": { "$ref": "#/definitions/modelHardware" }
            }
          }
        },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keycloakSecretName": { "type": "string", "minLength": 1 },
        "clusterWrites": { "type": "boolean" },
        "idpSecrets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "namespace", "createNamespace"],
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$" },
            "createNamespace": { "type": "boolean" }
          }
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "pattern": "^(https://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]{1,5})?/.*)?$" },
            "branch": { "type": "string", "minLength": 1 },
            "tokenSecretName": { "type": "string", "minLength": 1 },
            "gridNamespace": { "type": "string", "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)?$" },
            "modelsNamespace": { "type": "string", "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)?$" }
          }
        },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "authProxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upstreamTimeout": {
          "description": "kube-auth-proxy's --upstream-timeout, such as 65s: longer than the BFF's 60s server write timeout.",
          "type": "string",
          "pattern": "^[1-9][0-9]*(s|m|h)$"
        },
        "resources": { "$ref": "#/definitions/resources" }
      }
    }
  },
  "definitions": {
    "image": {
      "description": "repository:tag, repository@digest, or repository:tag@digest when both are set.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": {
          "description": "algorithm:hex, such as sha256:<64 hex digits>; empty for none.",
          "type": "string",
          "pattern": "^([a-z0-9]+:[a-f0-9]+)?$"
        }
      }
    },
    "modelHardware": {
      "description": "One hardware choice (bff/internal/config/hardware.go, ModelHardware).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "description": "A DNS label, unique in the list.", "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$" },
        "label": { "description": "Not only spaces: Unicode spaces count, as the BFF's strings.TrimSpace does.", "type": "string", "pattern": "[^\\s\\v\\x{85}\\p{Z}]" },
        "description": { "type": "string" },
        "accelerator": {
          "description": "The extended resource requested per accelerator, such as nvidia.com/gpu; empty for CPU only. A Kubernetes extended resource name: a DNS subdomain of at most 244 characters, a slash, and a name of at most 63; not containing kubernetes.io/ (a native resource) and not starting with requests.",
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*/[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?)?$",
          "allOf": [
            { "not": { "pattern": "^[^/]{245,}/" } },
            { "not": { "pattern": "kubernetes\\.io/" } },
            { "not": { "pattern": "^requests\\." } }
          ]
        },
        "image": { "description": "Empty: the cluster's default vLLM image, for NVIDIA GPUs.", "type": "string", "pattern": "^[^\\s\\v\\x{85}\\p{Z}]*$" },
        "env": {
          "type": "object",
          "propertyNames": { "pattern": "^[-._a-zA-Z][-._a-zA-Z0-9]*$", "not": { "const": "VLLM_ADDITIONAL_ARGS" } },
          "additionalProperties": { "type": "string" }
        },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accelerators": { "type": "integer", "minimum": 1, "maximum": 64 },
            "cpu": { "type": "string", "pattern": "^([1-9][0-9]*|0\\.[0-9]*[1-9][0-9]*|[1-9][0-9]*\\.[0-9]+|[1-9][0-9]*m)$" },
            "memory": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$" }
          }
        }
      },
      "if": { "not": { "required": ["accelerator"], "properties": { "accelerator": { "minLength": 1 } } } },
      "then": { "properties": { "defaults": { "not": { "required": ["accelerators"] } } } }
    },
    "quantities": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number"] }
    },
    "resources": {
      "description": "A container's resources (requests, limits, claims), as in a Pod spec.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "$ref": "#/definitions/quantities" },
        "limits": { "$ref": "#/definitions/quantities" },
        "claims": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
